{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
